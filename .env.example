# ============================================================================
# AutoSafeHarness / DTAP environment template  —  copy to `.env` and fill in YOUR keys.
# NOTHING in this file is a real credential. Never commit a filled-in .env.
# ============================================================================

# --- Victim (defended) model --------------------------------------------------
# The frozen agent AutoSafeHarness defends. One of the five panels from the paper, e.g.:
#   bedrock/us.anthropic.claude-sonnet-4-6
#   bedrock/zai.glm-5
#   bedrock/moonshotai.kimi-k2.5
#   openrouter/qwen/qwen3.7-plus
#   openrouter/deepseek/deepseek-v4-flash
DTAP_MODEL=
DTAP_AGENT_TYPE=langchain
DTAP_MAX_PARALLEL=4
DTAP_DATASET_ROOT=        # path where DTAP caches its (downloaded) dataset

# --- AWS Bedrock (only if your victim/judge is served via Bedrock) ------------
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
AWS_REGION_NAME=us-east-1
AWS_DEFAULT_REGION=us-east-1

# --- OpenAI (some DTAP code paths build a client during arg-parsing) ----------
OPENAI_API_KEY=

# --- OpenRouter (only if your victim/judge is served via OpenRouter) ----------
OPENROUTER_API_KEY=
OPENROUTER_REASONING_EFFORT=medium     # minimal|low|medium|high  (off/none disables)
OPENROUTER_PROVIDER_ORDER=             # optional: pin a tool-capable provider
OPENROUTER_DEEPSEEK_PROVIDER=          # optional: provider for deepseek judge

# --- Permission judge (simulated-user consent for the MCP servers) ------------
# A small, fixed model — Haiku-4.5 for the Bedrock victims, deepseek-v4-flash for
# the OpenRouter victims. scripts/judge_proxy.py bridges Bedrock<->OpenAI HTTP and
# is started automatically by scripts/run_dtap.sh.
JUDGE_PROXY_PORT=4111
JUDGE_MODEL=                           # tried first by judge_proxy.py
JUDGE_BEDROCK_MODEL=bedrock/anthropic.claude-haiku-4-5-20251001-v1:0
PERMISSION_LLM_API_BASE_URL=http://127.0.0.1:4111/v1
PERMISSION_LLM_API_KEY=sk-judge-local  # localhost-only dummy; any non-empty value
PERMISSION_LLM_MODEL=judge
